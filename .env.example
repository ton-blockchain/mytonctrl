# Independent image tags. Pin TON_IMAGE to a version or digest in production.
TON_IMAGE=ghcr.io/ton-blockchain/ton:latest
MYTONCTRL_IMAGE=ghcr.io/ton-blockchain/mytonctrl:latest
TON_ARTIFACTS_VOLUME=mytonctrl-ton-artifacts
TON_SCRIPTS_VOLUME=mytonctrl-ton-scripts
TON_WORK_VOLUME=mytonctrl-ton-work

# Optional: absolute host directory on the disk used for TON data.
# Blank uses the standard Docker volume named by TON_WORK_VOLUME.
# For an external directory, mount the disk first (e.g. /mnt/ton/ton-work).
# Both storage modes mount at /var/ton-work inside the container.
TON_WORK_HOST_DIR=

# Blank autodetects public IPv4. Set explicitly for a different advertised address (e.g. NAT).
PUBLIC_IP=
# Original installer arguments. Applied once to an empty TON work volume.
# -c URL or /mounted/config.json; -i ignores CPU/RAM requirements; -t disables telemetry.
# -s also skips checks when opening the console. See README.docker.md for all options.
MYTONCTRL_ARGS=-m validator -n mainnet -d

# Defaults for predictable ports (host networking in compose.yaml).
VALIDATOR_PORT=30303
VALIDATOR_CONSOLE_PORT=30304
LITESERVER_PORT=30305
QUIC_PORT=31303

DUMP_EXTRACT_THREADS=1
VERBOSITY=1
CUSTOM_PARAMETERS=

# Native mounts are used if /ton-artifacts/current is absent.
TON_ARTIFACTS_DIR=/ton-artifacts
TON_BINARIES_DIR=/ton-source/bin
FIFT_LIB_DIR=/ton-source/fift
TON_SMARTCONT_DIR=/ton-source/smartcont
